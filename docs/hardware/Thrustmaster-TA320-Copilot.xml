<?xml version="1.0"?>

<PropertyList>
  <name type="string">Thrustmaster T.A320 Copilot</name>

  <axis>
    <desc type="string">Aileron</desc>
    <dead-band type="double">0.05</dead-band>
    <binding>
      <command type="string">property-scale</command>
      <property type="string">/controls/flight/aileron</property>
      <factor type="double">1</factor>
      <offset type="double">0</offset>
      <power type="double">2</power>
    </binding>
  </axis>

  <axis n="1">
    <desc type="string">Elevator</desc>
    <binding>
      <command type="string">property-scale</command>
      <property type="string">/controls/flight/elevator</property>
      <factor type="double">-1</factor>
      <offset type="double">0</offset>
      <power type="double">1</power>
    </binding>
  </axis>

  <axis n="2">
    <desc type="string">Rudder</desc>
    <dead-band type="double">0.07</dead-band>
    <binding>
      <command type="string">property-scale</command>
      <property type="string">/controls/flight/rudder</property>
      <factor type="double">1</factor>
      <offset type="double">0</offset>
      <power type="double">2</power>
    </binding>
  </axis>

  <axis n="3">
    <desc type="string">Mixture All Engines</desc>
    <binding>
      <command type="string">property-scale</command>
      <property type="string">/controls/engines/mixture-all</property>
      <factor type="double">1</factor>
      <offset type="double">0</offset>
      <power type="double">1</power>
    </binding>
  </axis>

  <axis n="4">
    <desc type="string">View (horizontal)</desc>
    <low>
      <binding>
        <command type="string">nasal</command>
        <script type="string">setprop("/sim/current-view/goal-heading-offset-deg", getprop("/sim/current-view/goal-heading-offset-deg") + 2);</script>
      </binding>
      <repeatable type="bool">true</repeatable>
    </low>
    <high>
      <binding>
        <command type="string">nasal</command>
        <script type="string">setprop("/sim/current-view/goal-heading-offset-deg", getprop("/sim/current-view/goal-heading-offset-deg") - 2);</script>
      </binding>
      <repeatable type="bool">true</repeatable>
    </high>
  </axis>

  <axis n="5">
    <desc type="string">View (vertical)</desc>
    <low>
      <binding>
        <command type="string">nasal</command>
        <script type="string">setprop("/sim/current-view/goal-pitch-offset-deg", getprop("/sim/current-view/goal-pitch-offset-deg") - 1);</script>
      </binding>
      <repeatable type="bool">true</repeatable>
    </low>
    <high>
      <binding>
        <command type="string">nasal</command>
        <script type="string">setprop("/sim/current-view/goal-pitch-offset-deg", getprop("/sim/current-view/goal-pitch-offset-deg") + 1);</script>
      </binding>
      <repeatable type="bool">true</repeatable>
    </high>
  </axis>

  <button>
    <desc type="string">Brakes</desc>
    <repeatable type="bool">false</repeatable>
    <binding>
      <command type="string">nasal</command>
      <script type="string">controls.applyBrakes(1);</script>
    </binding>
    <mod-up>
      <binding>
        <command type="string">nasal</command>
        <script type="string">controls.applyBrakes(0);</script>
      </binding>
    </mod-up>
  </button>

  <button n="1">
    <desc type="string">Reset Cockpit View</desc>
    <binding>
      <condition>
        <equals>
          <property>/sim/current-view/view-number</property>
          <value>0</value>
        </equals>
      </condition>
      <command type="string">nasal</command>
      <script type="string">
          setprop("/sim/current-view/y-offset-m", 0.285);
          setprop("/sim/current-view/field-of-view", 42);
          setprop("/sim/current-view/heading-offset-deg", 0);
          setprop("/sim/current-view/pitch-offset-deg", -14);
          setprop("/sim/current-view/roll-offset-deg", 0);
          setprop("/sim/current-view/goal-heading-offset-deg", 0);
          setprop("/sim/current-view/goal-pitch-offset-deg", -14);
          setprop("/sim/current-view/goal-roll-offset-deg", 0);
          setprop("/sim/current-view/user/y-offset-m", 0.285);
          setprop("/sim/current-view/user/pitch-offset-deg", -14);
          setprop("/sim/current-view/user/default-field-of-view-deg", 42);
      </script>
    </binding>
    <repeatable type="bool">false</repeatable>
  </button> 

  <button n="2">
    <desc type="string">View Cycle Forwards</desc>
    <binding>
      <command type="string">nasal</command>
      <script type="string">view.stepView(1);</script>
    </binding>
    <repeatable type="bool">false</repeatable>
  </button>

  <button n="3">
    <desc type="string">View Cycle Backwards</desc>
    <binding>
      <command type="string">nasal</command>
      <script type="string">view.stepView(-1);</script>
    </binding>
    <repeatable type="bool">false</repeatable>
  </button>

  <button n="4">
    <desc type="string">Elevator Trim Down</desc>
    <binding>
      <command type="string">nasal</command>
      <script type="string">controls.elevatorTrim(1);</script>
    </binding>
    <repeatable type="bool">true</repeatable>
  </button>

  <button n="5">
    <desc type="string">Brake Left</desc>
    <binding>
      <command type="string">nasal</command>
      <script type="string">setprop("/controls/gear/brake-left", 1);</script>
    </binding>
    <mod-up>
      <binding>
        <command type="string">nasal</command>
        <script type="string">setprop("/controls/gear/brake-left", 0);</script>
      </binding>
    </mod-up>
    <repeatable type="bool">false</repeatable>
  </button>

  <button n="6">
    <desc type="string">Seat Up</desc>
    <binding>
      <command type="string">property-adjust</command>
      <property type="string">/sim/current-view/user/y-offset-m</property>
      <step type="double">0.005</step>
      <min type="double">0.15</min>
      <max type="double">0.35</max>
    </binding>
    <binding>
      <command type="string">property-adjust</command>
      <property type="string">/sim/current-view/y-offset-m</property>
      <step type="double">0.005</step>
      <min type="double">0.15</min>
      <max type="double">0.35</max>
    </binding>
    <repeatable type="bool">true</repeatable>
  </button>

  <button n="7">
    <desc type="string">Seat Down</desc>
    <binding>
      <command type="string">property-adjust</command>
      <property type="string">/sim/current-view/user/y-offset-m</property>
      <step type="double">-0.005</step>
      <min type="double">0.15</min>
      <max type="double">0.35</max>
    </binding>
    <binding>
      <command type="string">property-adjust</command>
      <property type="string">/sim/current-view/y-offset-m</property>
      <step type="double">-0.005</step>
      <min type="double">0.15</min>
      <max type="double">0.35</max>
    </binding>
    <repeatable type="bool">true</repeatable>
  </button>

  <button n="8">
    <desc type="string">Brake Right</desc>
    <binding>
      <command type="string">nasal</command>
      <script type="string">setprop("/controls/gear/brake-right", 1);</script>
    </binding>
    <mod-up>
      <binding>
        <command type="string">nasal</command>
        <script type="string">setprop("/controls/gear/brake-right", 0);</script>
      </binding>
    </mod-up>
    <repeatable type="bool">false</repeatable>
  </button>

  <button n="9">
    <desc type="string">Elevator Trim Up</desc>
    <binding>
      <command type="string">nasal</command>
      <script type="string">controls.elevatorTrim(-1);</script>
    </binding>
    <repeatable type="bool">true</repeatable>
  </button>

  <button n="10">
    <desc type="string">View Decrease</desc>
    <binding>
      <command type="string">nasal</command>
      <script type="string">view.decrease(0.75);</script>
    </binding>
    <repeatable type="bool">true</repeatable>
  </button>

  <button n="15">
    <desc type="string">View Increase</desc>
    <binding>
      <command type="string">nasal</command>
      <script type="string">view.increase(0.75);</script>
    </binding>
    <repeatable type="bool">true</repeatable>
  </button>

  <button n="16">
    <desc type="string">Engine Primer</desc>
    <binding>
      <command type="string">nasal</command>
      <script type="string">c172p.pumpPrimer();</script>
    </binding>
    <repeatable type="bool">false</repeatable>
    <mod-up>
      <binding>
        <command type="string">nasal</command>
        <script type="string">c172p.pumpPrimer();</script>
      </binding>
    </mod-up>
  </button>

</PropertyList>
